APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# LLM teks (Ask PANDA). Embedding tetap memakai GEMINI_API_KEY lewat GeminiClient.
LLM_PROVIDER=gemini
LLM_FALLBACKS=
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
# Model lain yang dicoba kalau model utama balas 503/429 (dipisah koma).
GEMINI_LLM_MODEL_FALLBACKS=gemini-flash-lite-latest,gemini-3.8-flash,gemini-flash-latest
# Retry singkat per model sebelum pindah ke model fallback.
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_SLEEP_MS=1500

# Batas generator Study Pack (opsional).
STUDY_PACK_MAX_INPUT_CHARS=20000
STUDY_PACK_MAX_CONCEPTS=8
STUDY_PACK_QUESTIONS_PER_CONCEPT=2
STUDY_PACK_OPTIONS_COUNT=4
